{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/p/**",
        "function": "pageSSR"
      },
      {
        "source": "/teacher.html",
        "destination": "/teacher.html"
      },
      {
        "source": "/editor.html",
        "destination": "/editor.html"
      },
      {
        "source": "/lesson-planning.html",
        "destination": "/lesson-planning.html"
      },
      {
        "source": "/view.html",
        "destination": "/view.html"
      },
      {
        "source": "/page-manager.html",
        "destination": "/page-manager.html"
      },
      {
        "source": "/page-editor.html",
        "destination": "/page-editor.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": {
    "source": "functions"
  }
}
