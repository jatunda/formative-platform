{
  // Type-checks plain JS from its JSDoc, no build step. Every JS file is
  // included, but with checkJs off only files whose first line is
  // `// @ts-check` are checked, so that header alone opts a module in.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true
  },
  "include": ["**/*.js", "firebase-database.d.ts"],
  "exclude": ["node_modules", "coverage", "dist", "__tests__"]
}
