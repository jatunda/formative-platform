{
  // Type-checks plain JS from its JSDoc, no build step. Only files that opt in
  // with a `// @ts-check` first line are checked; add it as modules are ready.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true
  },
  "include": ["robotics/**/*.js", "question-backlinks.js", "slug-index.js", "backlinks.js", "database-handle.js", "lesson-store.js", "unique-key.js", "realtime-store.js", "schedule-lessons.js", "firebase-database.d.ts"]
}
